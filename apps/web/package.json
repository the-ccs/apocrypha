{
  "name": "@apocrypha/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "tsc --build client/tsconfig.json && vite build --config vite.config.ts",
    "build:server": "tsc --build server/tsconfig.json",
    "typecheck": "tsc --build --pretty false",
    "dev": "vite --config vite.config.ts",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2"
  }
}
